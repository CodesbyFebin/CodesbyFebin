# CodesbyFebin Portfolio - Environment Configuration
# Copy this file to .env and fill in your values

# Site Configuration
SITE_NAME=CodesbyFebin
SITE_URL=https://codesbyfebin.vercel.app
SITE_AUTHOR=Febin Francis
SITE_EMAIL=febin@codesbyfebin.com

# Analytics (Optional)
GOOGLE_ANALYTICS_ID=
VERCEL_ANALYTICS_ENABLED=true

# Search Console
GOOGLE_SEARCH_CONSOLE_SITE=https://codesbyfebin.vercel.app/
BING_WEBMASTER_SITE=https://codesbyfebin.vercel.app/

# GitHub Configuration
GITHUB_OWNER=CodesbyFebin
GITHUB_REPO=CodesbyFebin
GITHUB_PAGES_ENABLED=true

# Social Media
TWITTER_HANDLE=codesbyfebin
LINKEDIN_URL=https://linkedin.com/in/codesbyfebin
GITHUB_URL=https://github.com/CodesbyFebin
DISCORD_URL=

# Deployment
VERCEL_PROJECT_ID=prj_ybrpKI2fQZiuh7btJvlEvrAt0Ekv
VERCEL_ORG_ID=team_f2yaJJSzp3wc0EsG3PvcZ24D

# Performance Monitoring
LIGHTHOUSE_THRESHOLD_PERFORMANCE=95
LIGHTHOUSE_THRESHOLD_ACCESSIBILITY=95
LIGHTHOUSE_THRESHOLD_BEST_PRACTICES=95
LIGHTHOUSE_THRESHOLD_SEO=90

# SEO Settings
SEO_ENABLE_ROBOTS_TXT=true
SEO_ENABLE_SITEMAP=true
SEO_ENABLE_SCHEMA_MARKUP=true
CANONICAL_URL=https://codesbyfebin.vercel.app

# Cache Configuration
CACHE_STRATEGY=CDN
CDN_PROVIDER=vercel

# Development
NODE_ENV=production
DEBUG=false
