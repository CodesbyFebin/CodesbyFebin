{
  "name": "codesbyfebin-portfolio",
  "version": 2,
  "buildCommand": "echo 'Static site - no build required'",
  "public": true,
  "projectSettings": {
    "framework": "other",
    "buildCommand": null,
    "outputDirectory": "."
  },
  "env": [],
  "functions": {},
  "rewrites": [
    {
      "source": "/feed",
      "destination": "/feed.xml"
    },
    {
      "source": "/feed.xml",
      "destination": "/feed.xml"
    }
  ],
  "routes": [
    {
      "src": "^/(?!.*\\.).*$",
      "methods": ["GET", "HEAD"],
      "dest": "/$1"
    }
  ],
  "headers": [
    {
      "source": "/assets/profile-header.svg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(index|portfolio)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        },
        {
          "key": "Content-Type",
          "value": "text/html; charset=utf-8"
        }
      ]
    },
    {
      "source": "/feed.xml",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        },
        {
          "key": "Content-Type",
          "value": "application/rss+xml; charset=utf-8"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
